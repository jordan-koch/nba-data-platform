# Copy to .env and fill in. .env is gitignored — never commit real values.
# This repo is public; treat account IDs and bucket names as secrets.

# ─── Environment selector ─────────────────────────────────────────────────────
# local  — everything on disk: landing zone in var/, warehouse in DuckDB. No cloud, no cost.
# dev    — S3 landing + Snowflake dev database.
# prod   — S3 landing + Snowflake prod database. Nightly Airflow runs write here.
NBA_ENV=local

# ─── Extraction ───────────────────────────────────────────────────────────────
# Minimum seconds between stats.nba.com requests. The endpoint is undocumented and
# unthrottled by contract — being impolite here gets the client blocked, not rate-limited.
# See docs/data-sources.md before lowering.
NBA_REQUEST_DELAY_SECONDS=0.6
NBA_MAX_RETRIES=5

# ─── Cloud (Phase 1+) ─────────────────────────────────────────────────────────
# Unused while NBA_ENV=local. Documented here so the shape is known before the
# migration, not discovered during it.
# AWS_REGION=us-east-2
# AWS_PROFILE=nba-platform
# S3_LANDING_BUCKET=
# S3_LAKEHOUSE_BUCKET=
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
