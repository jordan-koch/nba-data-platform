# Copy to .env and fill in. .env is gitignored — never commit real values.
# This repo is public; treat account IDs and bucket names as secrets.

# ─── Environment selector ─────────────────────────────────────────────────────
# local  — everything on disk: landing zone in var/, warehouse in DuckDB. No cloud, no cost.
# dev    — S3 landing + Snowflake dev database.
# prod   — S3 landing + Snowflake prod database. Nightly Airflow runs write here.
NBA_ENV=local

# ─── Extraction ───────────────────────────────────────────────────────────────
# Minimum seconds between stats.nba.com requests. The endpoint is undocumented and
# unthrottled by contract — being impolite here gets the client blocked, not rate-limited.
# See docs/data-sources.md before lowering.
NBA_REQUEST_DELAY_SECONDS=0.6
NBA_MAX_RETRIES=5

# The delay is a floor by convention, not by clamp: config rejects zero and negative values
# but honours a lower one, because lowering it is a deliberate act this file already tells you
# to read docs/data-sources.md before taking. A hard clamp would also make the stubbed-clock
# pacing test unable to prove the value is config-driven at all.

# ─── Overrides ────────────────────────────────────────────────────────────────
# All four are derived by src/nba_platform/config.py and listed here for discoverability.
# Uncomment one only to move something off its derived location.
# NBA_LANDING_ROOT=        # default var/landing — a relative value anchors at the repo root
# NBA_WAREHOUSE_PATH=      # default var/warehouse/nba_local.duckdb, per transform/profiles.yml
# NBA_PILOT_SEASONS=2003-04,2019-20,2024-25   # widening the pilot is a parameter change
# NBA_REPO_ROOT=           # only when running from an installed wheel, where no pyproject.toml
                           # sits on disk for the upward walk to find

# ─── Cloud (Phase 1+) ─────────────────────────────────────────────────────────
# Unused while NBA_ENV=local. Documented here so the shape is known before the
# migration, not discovered during it.
# AWS_REGION=us-east-2
# AWS_PROFILE=nba-platform
# S3_LANDING_BUCKET=
# S3_LAKEHOUSE_BUCKET=
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
