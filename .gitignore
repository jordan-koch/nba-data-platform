# ─── Secrets ──────────────────────────────────────────────────────────────────
# Never commit credentials. The repo is public; assume anything here is world-readable.
.env
.env.*
!.env.example
*.pem
*.key
credentials
credentials.json
secrets.yml
secrets.yaml

# ─── Scratch root ─────────────────────────────────────────────────────────────
# var/ is the gitignored working root: local landing zone, DuckDB files, caches,
# checkpoints, run state. Everything here is regenerable — see CLAUDE.md.
var/

# ─── Data ─────────────────────────────────────────────────────────────────────
# This repo holds code, contracts, docs, and fixtures — never bulk data.
# Test fixtures are the one carve-out and are whitelisted explicitly below.
*.duckdb
*.duckdb.wal
*.parquet
*.avro
*.orc
*.csv
*.tsv
*.jsonl
*.ndjson
!tests/fixtures/**/*.json
!tests/fixtures/**/*.csv
!transform/seeds/**/*.csv

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ─── Pipeline panel output ────────────────────────────────────────────────────
# The scoping and planning panels emit large mechanical serializations of their raw
# agent output (~100-230 KB each). Everything the final artifact depends on is carried
# verbatim INTO that artifact, so the tracked document stands alone in a fresh clone;
# these are the working files behind it and stay machine-local.
#
# Deliberately narrow — only the panel dumps. Everything else under reviews/ stays
# TRACKED, because it is evidence rather than working material: harness and endpoint
# probes, agent handoffs, tree-integrity records. Blocker fix F2 of the
# data-engineer-agent scope moved that evidence out of gitignored var/ precisely so it
# would be reproducible and visible to CI, and tests/test_handoff_contract.py globs
# reviews/*.md — an ignored reviews/ would leave it linting nothing while still green.
#
# Reference these files as inline code, never as Markdown links: they are absent from a
# fresh clone, and tests/test_doc_links.py is not gitignore-aware, so a link to one
# passes locally and fails in CI.
requests/*/*/reviews/*-proposals.md
requests/*/*/reviews/*-adversarial.md

# ─── dbt ──────────────────────────────────────────────────────────────────────
target/
dbt_packages/
logs/
# dbt writes an anonymous telemetry user id here — machine-local, not project config.
.user.yml
# transform/profiles.yml IS committed — it holds no secrets. The local target is a
# DuckDB file path; cloud targets resolve credentials through env_var() at runtime.

# ─── Terraform ────────────────────────────────────────────────────────────────
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ─── Airflow ──────────────────────────────────────────────────────────────────
airflow.db
airflow.cfg
webserver_config.py
standalone_admin_password.txt

# ─── Node / web app ───────────────────────────────────────────────────────────
node_modules/
.next/
.vite/
app/dist/

# ─── Notebooks ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Editors & OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
